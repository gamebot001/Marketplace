# ============================================================
# ZECIANS environment configuration — PHASE 1 (Solana Devnet)
#
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# No secrets, seed phrases, or private keys belong here.
# ============================================================

# --- Application ---
ZECIANS_SOLANA_NETWORK=solana-devnet
ZECIANS_ENV=development
ZECIANS_SERVER_SECRET=change_me_local_only

# --- Solana RPC (read-only usage) ---
SOLANA_RPC_URL=
# Treasury that receives Zecians marketplace fees. Public address only.
SOLANA_TREASURY_ADDRESS=
# Marketplace program id (deployed to Devnet in Phase 1).
ZECIANS_MARKETPLACE_PROGRAM_ID=
# Marketplace fee in basis points (250 = 2.5%). Must match the on-chain value.
ZECIANS_MARKETPLACE_FEE_BPS=250
# Phase 1 test collection has no enforced royalty.
ZECIANS_ROYALTY_BPS=0

# --- Database (not used in Phase 1; JsonFileStore remains) ---
POSTGRES_USER=zecians
POSTGRES_PASSWORD=zecians_dev_only
POSTGRES_DB=zecians
POSTGRES_PORT=5433
DATABASE_URL=postgresql://zecians:zecians_dev_only@localhost:5433/zecians

# --- Safety ---
ALLOW_MAINNET=no

# ============================================================
# ZECIANS environment configuration (Solana-native)
#
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# Every variable below is safe to keep at its default for LOCAL,
# DEVNET development. No secrets, seed phrases, or private keys
# belong in this file or in `.env`.
# ============================================================

# --- Application ---
# solana-devnet | solana-testnet | solana-mainnet-beta
# (solana-mainnet-beta is refused by all backend code until launch)
ZECIANS_SOLANA_NETWORK=solana-devnet
ZECIANS_ENV=development
# Secret used to sign session tokens / challenges. For local dev only.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ZECIANS_SERVER_SECRET=change_me_local_only

# --- Solana RPC (READ-ONLY usage in this phase) ---
# Leave blank to use the public default for the selected network.
SOLANA_RPC_URL=
# Treasury that receives Zecians platform fees + primary mint proceeds.
# Public address only. NEVER a private key.
SOLANA_TREASURY_ADDRESS=
# Marketplace program id. Blank until the program is deployed (devnet first).
ZECIANS_MARKETPLACE_PROGRAM_ID=
# Marketplace fee in basis points (1 bps = 0.01%). Configurable; 0 = disabled.
# Final percentages are NOT decided yet.
ZECIANS_MARKETPLACE_FEE_BPS=0
# Fallback creator royalty in basis points when on-chain metadata omits it.
ZECIANS_ROYALTY_BPS=0

# --- Database (PostgreSQL via docker-compose) ---
# Dev-only credentials. Change before any real deployment.
POSTGRES_USER=zecians
POSTGRES_PASSWORD=zecians_dev_only
POSTGRES_DB=zecians
POSTGRES_PORT=5433
DATABASE_URL=postgresql://zecians:zecians_dev_only@localhost:5433/zecians

# --- Mint / issuance safety ---
# Hard safety switches. Issuance is not implemented in this phase and no
# mainnet action is possible; these exist to make that explicit.
ALLOW_MAINNET=no

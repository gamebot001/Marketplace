    "phase2a:mint": "tsx phase2a-mint.ts",
    "phase2a:market": "tsx phase2a-marketplace.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anchor-lang/core": "0.32.2",
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {

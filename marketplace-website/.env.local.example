# ============================================================
# Zecians Marketplace — frontend environment (safe public values)
#
# Copy to `.env.local`. These are ALL public, build-time values.
# NEVER place a private key, seed phrase, or secret here.
# ============================================================

# Backend API base URL.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8788

# Solana cluster for this marketplace build. Devnet only in Phase 1.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Zecians marketplace program id (deployed on Devnet in Phase 1).
NEXT_PUBLIC_MARKETPLACE_PROGRAM_ID=

# Set to 0 to disable the isolated design-preview dataset and read the real
# backend. Phase 1 requires 0 (real chain data).
NEXT_PUBLIC_DEMO_MARKETPLACE=0

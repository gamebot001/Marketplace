# ============================================================
# Zecians Marketplace — frontend environment (safe public values)
#
# Copy to `.env.local`. These are ALL public, build-time values.
# NEVER place a private key, seed phrase, or secret here.
# ============================================================

# Backend API base URL (same contract as the Zecians platform API).
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8788

# Solana cluster for this marketplace build.
# Devnet only during development. Mainnet must not be enabled here.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Marketplace program id. Blank means the on-chain program is not deployed yet —
# buy/list/cancel will surface an honest "not available" state and never fake a
# transaction. Set this only once a real devnet program exists.
NEXT_PUBLIC_MARKETPLACE_PROGRAM_ID=

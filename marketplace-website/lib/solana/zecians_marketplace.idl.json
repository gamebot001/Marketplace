  "types": [
    {
      "name": "Listing",
      "docs": [
        "A per-asset escrow listing. The listing PDA itself becomes the owner of the",
        "Metaplex Core asset while `status == Active`, which is what makes the escrow",
        "real on-chain rather than a database flag."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "marketplace",
            "type": "pubkey"
          },
          {
            "name": "asset",
            "type": "pubkey"
          },
          {
            "name": "collection",
            "docs": [
              "Optional Metaplex Core collection the asset belongs to."
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "seller",
            "type": "pubkey"
          },
          {
            "name": "price_lamports",
            "type": "u64"
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "ListingStatus"
              }
            }
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "updated_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "ListingCancelled",
      "docs": [
        "Emitted when the seller reclaims an escrowed asset."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "marketplace",
            "type": "pubkey"
          },
          {
            "name": "listing",
            "type": "pubkey"
          },
          {
            "name": "asset",
            "type": "pubkey"
          },
          {
            "name": "seller",
            "type": "pubkey"
          },
          {
            "name": "timestamp",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "ListingCreated",
      "docs": [
        "Emitted when a Core asset has been escrowed and a listing becomes Active."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "marketplace",
            "type": "pubkey"
          },
          {
            "name": "listing",
            "type": "pubkey"
          },
          {
            "name": "asset",
            "type": "pubkey"
          },
          {
            "name": "seller",
            "type": "pubkey"
          },
          {
            "name": "price_lamports",
            "type": "u64"
          },
          {
            "name": "timestamp",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "ListingStatus",
      "docs": [
        "Listing lifecycle. Phase 1 only needs these four states; expiry is not",
        "implemented."
      ],
      "type": {
        "kind": "enum",
        "variants": [
          {
            "name": "Pending"
          },
          {
            "name": "Active"
          },
          {
            "name": "Sold"
          },
          {
            "name": "Cancelled"
          }
        ]
      }
    },
    {
      "name": "Marketplace",
      "docs": [
        "Phase 1 marketplace configuration. Deliberately small: only the switches",
        "and fee that the escrow listing flow actually needs."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "docs": [
              "Platform authority that initialised the marketplace."
            ],
            "type": "pubkey"
          },
          {
            "name": "treasury",
            "docs": [
              "Public key that receives marketplace fees. Never a signing wallet."
            ],
            "type": "pubkey"
          },
          {
            "name": "marketplace_fee_bps",
            "docs": [
              "Marketplace fee in basis points. Integer lamports settlement only."
            ],
            "type": "u16"
          },
          {
            "name": "listing_enabled",
            "docs": [
              "When false, new listings are refused."
            ],
            "type": "bool"
          },
          {
            "name": "buy_enabled",
            "docs": [
              "When false, purchases are refused."
            ],
            "type": "bool"
          },
          {
            "name": "paused",
            "docs": [
              "Global kill switch."
            ],
            "type": "bool"
          },
          {
            "name": "created_at",
            "type": "i64"
          },
          {
            "name": "updated_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "MarketplaceInitialized",
      "docs": [
        "Emitted once when the marketplace configuration account is created."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "marketplace",
            "type": "pubkey"
          },
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "treasury",
            "type": "pubkey"
          },
          {
            "name": "marketplace_fee_bps",
            "type": "u16"
          },
          {
            "name": "timestamp",
            "type": "i64"
          }
        ]
      }
    },
